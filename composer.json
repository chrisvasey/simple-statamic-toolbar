{
    "name": "chrisvasey/simple-statamic-toolbar",
    "description": "A lightweight floating toolbar for Statamic that gives logged-in users quick access to the CP and entry editor",
    "license": "MIT",
    "keywords": [
        "statamic",
        "toolbar",
        "edit",
        "control-panel"
    ],
    "autoload": {
        "psr-4": {
            "Chrisvasey\\SimpleStatamicToolbar\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Chrisvasey\\SimpleStatamicToolbar\\Tests\\": "tests"
        }
    },
    "require": {
        "statamic/cms": "^6.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true
        }
    },
    "extra": {
        "statamic": {
            "name": "Simple Statamic Toolbar",
            "description": "A lightweight floating toolbar for Statamic that gives logged-in users quick access to the CP and entry editor"
        },
        "laravel": {
            "providers": [
                "Chrisvasey\\SimpleStatamicToolbar\\ServiceProvider"
            ]
        }
    },
    "prefer-stable": true,
    "minimum-stability": "beta"
}
